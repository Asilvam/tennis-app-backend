      "url": "{{ _.base_url }}/auth/validateToken",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"token\": \"{{ _.token }}\"\n}"
      }
    },
    {
      "_id": "req_auth_refresh",
