      "url": "{{ _.base_url }}/auth/checkBlocked",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.email_active }}\"\n}"
      }
    },
    {
      "_id": "req_auth_check_blocked",
      "_type": "request",
      "parentId": "fld_authentication",
      "name": "Check Blocked - Usuario Bloqueado",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/checkBlocked",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.email_blocked }}\"\n}"
      }
    },
    {
      "_id": "req_auth_check_noexist",
      "_type": "request",
      "parentId": "fld_authentication",
