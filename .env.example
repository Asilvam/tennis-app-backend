# Configuracion complementaria. El resto del entorno esta documentado en README.md.
# Valores activos sugeridos para local; configurar los valores Prod en Heroku.
# Los secretos son placeholders: reutilizar los actuales, no copiarlos al repositorio.

# Razon: destino del enlace enviado al recuperar la contrasena.
# Local: http://localhost:5173/restablecer-contrasena
# Prod: https://ctq.serviciosasm.cl/restablecer-contrasena
# Aplicado en Heroku el 2026-10-29; el host anterior sigue atendiendo enlaces existentes.
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/restablecer-contrasena

# Razon: conexion al microservicio de pagos, compartida por reservas y mensualidades.
# Local: http://localhost:3000/mercadopago
# Prod: https://mercadopago-service-ctq-2-9c4551b6f8ba.herokuapp.com/mercadopago
MP_API_URL=http://localhost:3000/mercadopago

# Razon: autenticar la comunicacion interna con el microservicio de Mercado Pago.
# Local: misma clave interna del microservicio local; conservar la existente.
# Prod: misma clave interna del microservicio en Heroku; conservar la existente.
INTERNAL_API_KEY=replace-with-the-existing-mercadopago-internal-key

# Razon: direccion del servicio de correo existente, tambien usado por mensualidades.
# Local: http://localhost:3001/email
# Prod: https://email-service-ctq-2-de64db61e8fb.herokuapp.com/email
EMAIL_SERVICE_API_URL=http://localhost:3001/email

# Razon: autenticar las solicitudes del backend al servicio de correo.
# Local: misma INTERNAL_API_KEY del servicio de correo local.
# Prod: misma INTERNAL_API_KEY del servicio de correo en Heroku.
EMAIL_SERVICE_API_KEY=replace-with-the-existing-email-internal-key

# Razon: habilitar los endpoints administrativos de cuotas e historial.
# Local: true con configuracion e indices financieros del piloto verificados.
# Prod: false hasta preparar y revisar la BD del entorno; despues true.
MEMBERSHIP_BILLING_ADMIN_ENABLED=true

# Razon: habilitar portal y control de acceso financiero, sin activar autoBlockEnabled.
# Local: true con el piloto inicializado; las cuentas inactivas siguen rechazadas.
# Prod: false hasta aprobar la liberacion del portal y sus permisos; despues true.
MEMBERSHIP_PORTAL_ENABLED=true

# Mercado Pago mensual reutiliza la conexion anterior, sin banderas adicionales.
# El microservicio verifica cuenta y modo con el proveedor; TEST es tarifa, no sandbox.
# Tarifas Titular/Carga, lista de prueba y autoBlockEnabled se administran en BD.
